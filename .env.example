# RPC endpoints
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://eth.llamarpc.com

# Block explorer for verification
BASESCAN_API_KEY=

# Deployer (used by forge script)
DEPLOYER_PRIVATE_KEY=

# Initial operator address (the LazyLionAgents backend wallet that
# submits ledger entries on behalf of authenticated holders).
OPERATOR_ADDRESS=

# Initial oracle signer address (the wallet whose signature
# adapter8004 will trust for evolve() calls).
ORACLE_SIGNER_ADDRESS=

# Mainnet Lazy Lions contract (immutable)
LAZY_LIONS_CONTRACT=0x8943C7bAC1914C9A7ABa750Bf2B6B09Fd21037E0
